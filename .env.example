# Copy to .env and fill in. Never commit .env.

# Storage: "neo4j" (Aura) or "memory" (networkx fallback)
STORE=memory

# Neo4j Aura Free (console.neo4j.io → instance → connection details)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Crusoe Managed Inference (console.crusoecloud.com → Admin → Security → Intelligence API keys)
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1

# OpenRouter (openrouter.ai/keys)
OPENROUTER_API_KEY=

# Model routing: comma-separated fallback lists, "provider:model"
MODEL_CHEAP=crusoe:openai/gpt-oss-120b,openrouter:openai/gpt-oss-120b
MODEL_STRONG=crusoe:moonshotai/Kimi-K2.6,openrouter:moonshotai/kimi-k2.6
MODEL_VISION=openrouter:google/gemini-3.8-flash

# Plaud: uses the Plaud CLI's stored login (run `plaud login` once). No key needed here.
PLAUD_MODE=cli
