# Copy to .env and fill in. Never commit .env.

# Storage: "neo4j" (Aura) or "memory" (in-memory fallback)
STORE=memory

# Neo4j Aura Free: values from the credentials file downloaded at instance creation
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Crusoe Managed Inference: console.crusoecloud.com → Admin → Security → Intelligence API keys
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
CRUSOE_MODEL_EXTRACT=openai/gpt-oss-120b
CRUSOE_MODEL_REASON=moonshotai/Kimi-K2.6

# Optional (should-have features)
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=google/gemini-3.8-flash
BRAVE_API_KEY=

# Plaud: no key; uses the Plaud CLI login (~/.plaud/tokens.json). Run `plaud login` once.
